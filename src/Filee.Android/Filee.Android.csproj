<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <ApplicationId>org.filee.mobile.community</ApplicationId>
    <ApplicationTitle>Filee Android (Community)</ApplicationTitle>
    <ApplicationVersion>18</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.17-alpha</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Filee.Core\Filee.Core.csproj" />
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="Xamarin.AndroidX.ExifInterface" />
  </ItemGroup>
  <!-- Included by CI only, for offline Android emulator tests. -->
  <ItemGroup Condition="Exists('ci/fixtures/basic-8bit-srgb.heic')">
    <EmbeddedResource Include="ci/fixtures/*.heic" />
  </ItemGroup>
</Project>